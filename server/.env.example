# Copy this file to ".env" and fill in your real connection string.
# Never commit the real .env file.

# LOCAL MongoDB (if you installed MongoDB Community Server / Docker):
# MONGODB_URI=mongodb://127.0.0.1:27017

# ATLAS (cloud, free tier) - looks like this, get it from Atlas > Connect > Drivers:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net

MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=codemaster_php
PORT=3000
